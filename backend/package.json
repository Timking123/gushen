{
  "name": "smart-stock-analyzer-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Smart Stock Analyzer - Backend API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "sync:quotes": "tsx scripts/sync-finnhub.ts quotes",
    "sync:news": "tsx scripts/sync-finnhub.ts news",
    "sync:candles": "tsx scripts/sync-finnhub.ts candles",
    "sync:all": "tsx scripts/sync-finnhub.ts all",
    "sync:daemon": "tsx scripts/sync-all-stocks.ts",
    "sync:skipped": "tsx scripts/sync-skipped-stocks.ts",
    "docs:generate": "tsx scripts/generate-api-docs.ts",
    "docs:database": "tsx scripts/generate-database-docs.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@types/compression": "^1.8.1",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "ws": "^8.19.0",
    "yahoo-finance2": "^3.13.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "fast-check": "^4.1.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.10.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.3.4",
    "tsx": "^4.20.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
