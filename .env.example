# ============================================
# 智能股票分析平台 - 环境变量配置模板
# ============================================
# 说明：
# 1. 复制此文件为 .env 并填入真实值
# 2. 不要将 .env 文件提交到版本控制
# 3. 所有敏感信息（密钥、密码）必须使用强随机值
# ============================================

# ============================================
# 后端服务器配置
# ============================================

# 运行环境：development（开发）、production（生产）、test（测试）
NODE_ENV=development

# 后端服务器端口号
PORT=3001

# ============================================
# 数据库配置
# ============================================

# PostgreSQL 数据库连接字符串
# 格式：postgresql://用户名:密码@主机:端口/数据库名?schema=模式名
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/smart_stock_analyzer?schema=public"

# ============================================
# Redis 缓存配置
# ============================================

# Redis 连接字符串
# 格式：redis://主机:端口
REDIS_URL="redis://localhost:6379"

# ============================================
# JWT 身份认证配置
# ============================================

# JWT 密钥（生产环境必须使用强随机字符串，至少 32 字符）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# JWT 令牌过期时间（例如：7d=7天，24h=24小时，60m=60分钟）
JWT_EXPIRES_IN="7d"

# ============================================
# CORS 跨域配置
# ============================================

# 允许的前端域名（开发环境通常是 Vite 开发服务器地址）
CORS_ORIGIN="http://localhost:5173"

# ============================================
# 外部 API 密钥配置
# ============================================

# Finnhub 股票数据 API 密钥
# 获取地址：https://finnhub.io/
FINNHUB_API_KEY="your_finnhub_api_key_here"

# Twelve Data 历史股票数据 API 密钥
# 获取地址：https://twelvedata.com/
TWELVE_DATA_API_KEY="your_twelve_data_api_key_here"

# Yahoo Finance API 密钥（如果使用）
YAHOO_FINANCE_API_KEY="your_yahoo_finance_api_key_here"

# 市场数据 API 密钥（通用）
MARKET_DATA_API_KEY="your_market_data_api_key_here"

# 新闻 API 密钥（如果使用）
NEWS_API_KEY="your_news_api_key_here"

# OpenAI API 密钥（用于 AI 助手功能）
OPENAI_API_KEY="your_openai_api_key_here"

# ============================================
# 日志配置
# ============================================

# 日志级别：error（错误）、warn（警告）、info（信息）、debug（调试）
LOG_LEVEL="info"

# ============================================
# 前端配置（Vite 环境变量，以 VITE_ 开头）
# ============================================

# 后端 API 基础 URL
VITE_API_BASE_URL="http://localhost:3001/api"

# WebSocket 连接 URL
VITE_WS_URL="http://localhost:3001"

# 功能开关 - AI 助手
VITE_ENABLE_AI_ASSISTANT=true

# 功能开关 - 推送通知
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# 前端市场数据 API 密钥（如果前端直接调用）
VITE_MARKET_DATA_API_KEY="your_api_key_here"

# 应用名称
VITE_APP_NAME="Smart Stock Analyzer"

# 应用版本
VITE_APP_VERSION="1.0.0"

# ============================================
# 可选配置
# ============================================

# 数据库连接池大小（可选）
# DATABASE_POOL_SIZE=10

# Redis 连接超时时间（毫秒，可选）
# REDIS_TIMEOUT=5000

# API 请求速率限制（每分钟请求数，可选）
# RATE_LIMIT_PER_MINUTE=100

# 会话超时时间（秒，可选）
# SESSION_TIMEOUT=3600

# 文件上传大小限制（MB，可选）
# MAX_UPLOAD_SIZE=10
